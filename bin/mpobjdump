#!/usr/bin/env python3

# Multi-thread object dump utility

import sys
import subprocess
import os
from concurrent.futures import ThreadPoolExecutor, as_completed

BATCH_SIZE = 1024 * 1024  # 512 KB

if __name__ == "__main__":
    args = sys.argv[1:]
    # Only supports objdump -D and -S for now
    if len(args) < 2 or args[0] not in ("-D", "-S"):
        print("Usage: mpobjdump.py [-D|-S] [options] <object_files...>")
        sys.exit(1)
    # Read symbol table first and then disassemble each function in parallel
    sym_table_cmd = ["objdump", "-t"] + args[1:]
    try:
        sym_table_output = subprocess.check_output(sym_table_cmd, universal_newlines=True)
    except subprocess.CalledProcessError as e:
        print(f"Error running objdump: {e}")
        sys.exit(1)
    functions = []
    symbol_table_start = False
    for line in sym_table_output.splitlines():
        if line == "SYMBOL TABLE:":
            symbol_table_start = True
            continue
        parts = line.split()
        if (len(parts) < 4) or (not symbol_table_start):
            continue
        addr = parts[0]
        flags = line[len(addr)+1:len(addr)+8].split()
        if 'F' not in flags:
            continue
        parts_after = line[len(addr)+9:].split()
        section = parts_after[0]
        if section != ".text":
            continue
        size = parts_after[1]
        name = parts_after[2]
        assert int(addr, 16) != 0
        functions.append((name, int(addr, 16), int(size, 16)))
    functions.sort(key=lambda x: x[1])
    # Disassemble functions in parallel
    def disassemble_function(vma_start, vma_end):
        disasm_cmd = ["objdump", "-D", "--start-address=0x{0:x}".format(vma_start),
                       "--stop-address=0x{0:x}".format(vma_end)] + args[1:]
        if args[0] == "-S":
            disasm_cmd.insert(1, "-S")
        try:
            output = subprocess.check_output(disasm_cmd, universal_newlines=True)
            return output
        except subprocess.CalledProcessError as e:
            return f"Error disassembling function at 0x{0:x}: {e}".format(vma_start)
    todo_list = [] # (start, stop)
    last_end = None
    for func in functions:
        if last_end is None:
            last_end = func[1]
        if func[1] - last_end >= BATCH_SIZE:
            todo_list.append((last_end, func[1]))
            last_end = func[1]
    if last_end is not None:
        todo_list.append((last_end, functions[-1][1] + functions[-1][2]))
    with ThreadPoolExecutor(max_workers=os.cpu_count()) as executor:
        future_to_func = {
            executor.submit(disassemble_function, start, end): (start, end)
            for (start, end) in todo_list
        }
        # Collect and print results as they complete in order
        for future in as_completed(future_to_func):
            func = future_to_func[future]
            try:
                data = future.result()
                print(data)
            except Exception as exc:
                print(f"Function {func[0]} generated an exception: {exc}")
